# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - GPTW-MBC (05_proyecto_clima)
# ==============================================================================

# Entorno de ejecución (production | development)
NODE_ENV=production

# Puerto HTTP de la aplicación (usado por PM2 y Next.js)
PORT=3001

# Conexión a base de datos SQLite (Prisma)
# Ruta relativa a la raíz del proyecto o ruta absoluta en Windows Server
DATABASE_URL="file:./dev.db"

# Clave secreta para tokens de autenticación JWT
JWT_SECRET="super_secreto_clave_mbc_2026_cuadra"

# Ruta física donde residen los archivos de imágenes de resultados/departamentos
# Puede ser una ruta local (ej. C:\Servidor\Datos\Clima) o UNC (\\servidor\compartido\Clima)
# Si no se define, en desarrollo buscará el fallback histórico H:\AUDITOR INTERNO\PRIVADO\5 Isaac\Clima
IMAGES_BASE_PATH="C:\Servidor\Datos\Clima"
